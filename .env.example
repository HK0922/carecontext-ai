# Optional model-assisted evidence selection. Local retrieval needs no API key.
# Export these variables in your shell; this file is NOT loaded automatically.
OPENAI_API_KEY=
CARECONTEXT_MODEL=
# Optional SQLite location (defaults to .data/carecontext.sqlite3).
CARECONTEXT_DB=.data/carecontext.sqlite3

# Local-only research: set explicitly; NEVER enable for internet deployments.
CARECONTEXT_RESEARCH_MODE=0
# Optional RxNorm/DailyMed medication-term-only lookup; does not send documents.
CARECONTEXT_RESEARCH_NETWORK=0
